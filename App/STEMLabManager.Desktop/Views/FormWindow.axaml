<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:STEMLabManager.Desktop.ViewModels"
        xmlns:c="using:STEMLabManager.Desktop.Controls" x:Class="STEMLabManager.Desktop.Views.FormWindow" x:DataType="vm:FormViewModel"
        Width="620" Height="700" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner" Title="{Binding Title}">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Margin="16" Padding="24">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Background="{DynamicResource PrimaryContainerBrush}" Width="44" Height="44" CornerRadius="14"><c:AppIcon Kind="{Binding Icon}" Foreground="{DynamicResource PrimaryTextBrush}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="STEM Lab Manager" Classes="caption" FontSize="11"/></StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="18">
          <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource SecondaryBrush}"/>
          <Image Source="{Binding Preview}" IsVisible="{Binding HasPreview}" MaxWidth="500" MaxHeight="300" Stretch="Uniform"/>
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FormField">
              <StackPanel Spacing="7" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/><TextBlock Text="*" IsVisible="{Binding Required}" Foreground="{DynamicResource ErrorBrush}" FontSize="12"/></StackPanel>
                <TextBox Text="{Binding Value}" AcceptsReturn="{Binding Multiline}" MinHeight="{Binding InputHeight}" PasswordChar="{Binding PasswordChar}" IsVisible="{Binding IsText}"/>
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Spacing="12">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12"/>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3"/>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Text="Esc để đóng" Classes="caption" FontSize="10" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Hủy" IsCancel="True" Command="{Binding CancelCommand}" IsEnabled="{Binding CanSave}"/>
          <Button Grid.Column="2" Classes="primary" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" IsDefault="True"><StackPanel Orientation="Horizontal" Spacing="8"><c:AppIcon Kind="check" Width="17" Height="17" Foreground="White"/><TextBlock Text="Xác nhận"/></StackPanel></Button>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
