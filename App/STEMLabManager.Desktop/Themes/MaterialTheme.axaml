<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:STEMLabManager.Desktop.Controls">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#315BDB" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#254BBF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#1D3EAA" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="MinWidth" Value="40" />
  </Style>
  <Style Selector="Button.outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.dateTimeField">
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="22" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.navList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="ListBox.navList ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="ListBox.navList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.navList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.navEntry">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.navEntry:pointerover">
    <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
  </Style>
  <Style Selector="Border.navEntry.active">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
  </Style>
  <Style Selector="Border.navEntry.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.navEntry.active c|AppIcon"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
  <Style Selector="Border.step"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="12"/></Style>
  <Style Selector="Border.step.active"><Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/></Style>
  <Style Selector="Border.stepNumber"><Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/></Style>
  <Style Selector="Border.step.active Border.stepNumber"><Setter Property="Background" Value="#315BDB"/></Style>
  <Style Selector="Border.step.active Border.stepNumber TextBlock"><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="ListBox.dataList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="ListBox.dataList ListBoxItem">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.dataList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
</Styles>
